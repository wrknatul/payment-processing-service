# Everything here is optional: docker compose works without a .env file.
# Copy to .env to override the defaults.

# --- service ---
API_KEY=dev-api-key
WEBHOOK_SIGNING_SECRET=dev-webhook-secret
WEBHOOK_TIMEOUT_SECONDS=5
MAX_ATTEMPTS=3
RETRY_BASE_DELAY_SECONDS=5
RETRY_BACKOFF_MULTIPLIER=2
CONSUMER_PREFETCH=10
OUTBOX_POLL_INTERVAL_SECONDS=1
OUTBOX_BATCH_SIZE=100
GATEWAY_MIN_DELAY_SECONDS=2
GATEWAY_MAX_DELAY_SECONDS=5
GATEWAY_SUCCESS_RATE=0.9
LOG_LEVEL=INFO

# --- ports published on the host ---
API_PORT=8000
WEBHOOK_SINK_PORT=8080
POSTGRES_PORT=5432
RABBITMQ_PORT=5672
RABBITMQ_UI_PORT=15672

# --- only when running outside of docker compose ---
# DATABASE_URL=postgresql+asyncpg://payments:payments@localhost:5432/payments
# RABBITMQ_URL=amqp://guest:guest@localhost:5672/
